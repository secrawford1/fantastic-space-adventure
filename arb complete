    // ============ Flash Loan Functions ============
    
    /**
     * @notice Execute arbitrage with flash loan
     * @param params Arbitrage parameters
     * @return profit Amount of profit generated
     */
    function _executeWithFlashLoan(
        ArbitrageParameters memory params
    ) internal returns (uint256) {
        // Calculate flash loan requirements
        uint256 flashLoanFee = (params.amounts[0] * FLASH_LOAN_FEE) / BASIS_POINTS;
        uint256 totalRequired = params.amounts[0] + flashLoanFee;

        // Store flash loan data
        activeFlashLoans[params.identifier] = FlashLoanData({
            path: params.path,
            dexPath: new address[](params.path.length - 1),
            borrowAmount: params.amounts[0],
            expectedProfit: params.expectedProfit,
            minAmountOut: params.minAmountOut,
            dexFees: new uint256[](params.path.length - 1),
            identifier: params.identifier,
            deadline: params.deadline,
            initiator: msg.sender,
            isActive: true,
            startTime: block.timestamp,
            gasPrice: tx.gasprice
        });

        // Verify flash loan capacity
        require(
            params.amounts[0] <= flastLoanCapacity,
            "Exceeds flash loan capacity"
        );
        require(
            flashLoanCount[params.path[0]] < 3,
            "Flash loan rate limit exceeded"
        );

        // Execute flash loan
        try lendingPool.flashLoanSimple(
            address(this),
            params.path[0],
            params.amounts[0],
            abi.encode(params.identifier),
            0
        ) {
            // Calculate actual profit
            uint256 endBalance = IERC20(params.path[0]).balanceOf(address(this));
            uint256 profit = endBalance > totalRequired ? endBalance - totalRequired : 0;

            // Cleanup flash loan data
            delete activeFlashLoans[params.identifier];

            emit FlashLoanExecuted(
                params.identifier,
                params.path[0],
                params.amounts[0],
                flashLoanFee,
                profit,
                block.timestamp
            );

            return profit;
        } catch (bytes memory reason) {
            // Cleanup on failure
            delete activeFlashLoans[params.identifier];
            
            emit FlashLoanFailed(
                params.identifier,
                "Flash loan execution failed",
                reason,
                block.timestamp
            );
            
            return 0;
        }
    }

    /**
     * @notice Flash loan callback function
     * @dev Called by lending pool after flash loan
     */
    function executeOperation(
        address asset,
        uint256 amount,
        uint256 premium,
        address initiator,
        bytes calldata params
    ) external override returns (bool) {
        require(msg.sender == address(lendingPool), "Unauthorized");
        
        // Decode flash loan data
        bytes32 loanId = abi.decode(params, (bytes32));
        FlashLoanData storage loan = activeFlashLoans[loanId];
        require(loan.isActive, "Invalid loan");
        
        // Calculate required repayment
        uint256 repayAmount = amount + premium;
        
        // Execute arbitrage path
        bool success = _executeArbitragePath(
            loan.path,
            amount,
            loan.minAmountOut
        );
        
        require(success, "Arbitrage execution failed");
        
        // Verify profit covers flash loan fee
        uint256 finalBalance = IERC20(asset).balanceOf(address(this));
        require(finalBalance >= repayAmount, "Insufficient profit");
        
        // Approve repayment
        IERC20(asset).approve(address(lendingPool), repayAmount);
        
        return true;
    }

