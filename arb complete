    // ============ Modifiers ============

    modifier onlyOperator() {
        require(hasRole(OPERATOR_ROLE, msg.sender), "Caller is not operator");
        _;
    }

    modifier onlyEmergencyAdmin() {
        require(hasRole(EMERGENCY_ADMIN_ROLE, msg.sender), "Caller not emergency admin");
        _;
    }

    modifier validatePath(address[] memory path) {
        require(path.length >= 2 && path.length <= MAX_PATH_LENGTH, "Invalid path length");
        for (uint256 i = 0; i < path.length; i++) {
            require(path[i] != address(0), "Invalid token address");
            require(authorizedTokens[path[i]], "Unauthorized token");
            if (i > 0) require(path[i] != path[i-1], "Duplicate tokens");
        }
        _;
    }

    modifier ensureDeadline(uint256 deadline) {
        require(block.timestamp <= deadline, "Deadline expired");
        _;
    }

    modifier validateGas() {
        require(gasleft() >= 100000, "Insufficient gas");
        require(tx.gasprice <= MAX_GAS_PRICE, "Gas price too high");
        _;
    }

    modifier nonReentrantFlashLoan() {
        require(!_stakeReentryGuard, "ReentrancyGuard: reentrant call");
        _stakeReentryGuard = true;
        _;
        _stakeReentryGuard = false;
    }

    modifier whenNotEmergency() {
        require(!emergencyState.emergencyMode, "Contract is in emergency mode");
        _;
    }

    modifier checkRateLimit() {
        require(dailyTrades < MAX_DAILY_TRADES, "Rate limit exceeded");
        _;
    }

