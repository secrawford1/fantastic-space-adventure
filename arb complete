    mapping(bytes32 => PriceData) public pairPriceData;
    mapping(bytes32 => PerformanceMetrics) public pathPerformance;
    uint256 private constant MAX_PRICE_POINTS = 1000;
    uint256 private constant METRICS_UPDATE_INTERVAL = 1 hours;

    /**
     * @notice Update analytics after trade
     * @param path Trading path
     * @param amounts Trade amounts
     * @param profit Generated profit
     * @param gasUsed Gas consumed
     */
    function _updateAnalytics(
        address[] memory path,
        uint256[] memory amounts,
        uint256 profit,
        uint256 gasUsed
    ) internal {
        // Update token analytics
        for (uint256 i = 0; i < path.length; i++) {
            _updateTokenAnalytics(path[i], amounts[i], profit > 0);
        }

        // Update pair analytics
        for (uint256 i = 0; i < path.length - 1; i++) {
            _updatePairAnalytics(path[i], path[i + 1], amounts[i], amounts[i + 1]);
        }

        // Update path performance
        _updatePathPerformance(path, profit, gasUsed);

        emit AnalyticsUpdated(
            keccak256(abi.encodePacked(path)),
            profit,
            gasUsed,
            block.timestamp
        );
    }

    /**
     * @notice Update token analytics
     * @param token Token address
     * @param amount Trade amount
     * @param success Whether trade was successful
     */
    function _updateTokenAnalytics(
        address token,
        uint256 amount,
        bool success
    ) internal {
        AnalyticsData storage data = tokenAnalytics[token];
        
        // Update if enough time has passed
        if (block.timestamp >= data.lastUpdate + METRICS_UPDATE_INTERVAL) {
            // Update volumes
            data.totalVolume += amount;
            data.volume24h = _calculate24hVolume(token);
            data.volumeMA7 = _calculateMovingAverage(token, 7 days);

            // Update success rate
            if (success) {
                data.successRate = _calculateNewRate(
                    data.successRate,
                    BASIS_POINTS,
                    totalExecutions
                );
            } else {
                data.successRate = _calculateNewRate(
                    data.successRate,
                    0,
                    totalExecutions
                );
            }

            data.lastUpdate = block.timestamp;
        }
    }

    /**
     * @notice Update pair analytics
     * @param token0 First token
     * @param token1 Second token
     * @param amount0 First amount
     * @param amount1 Second amount
     */
    function _updatePairAnalytics(
        address token0,
        address token1,
        uint256 amount0,
        uint256 amount1
    ) internal {
        bytes32 pairHash = _getPairHash(token0, token1);
        PriceData storage priceData = pairPriceData[pairHash];

        // Calculate price and add to history
        uint256 price = (amount1 * BASIS_POINTS) / amount0;
        
        if (priceData.prices.length >= MAX_PRICE_POINTS) {
            // Rotate array if full
            for (uint256 i = 0; i < priceData.prices.length - 1; i++) {
                priceData.prices[i] = priceData.prices[i + 1];
                priceData.timestamps[i] = priceData.timestamps[i + 1];
                priceData.volumes[i] = priceData.volumes[i + 1];
            }
            priceData.prices[priceData.prices.length - 1] = price;
            priceData.timestamps[priceData.timestamps.length - 1] = block.timestamp;
            priceData.volumes[priceData.volumes.length - 1] = amount0;
        } else {
            priceData.prices.push(price);
            priceData.timestamps.push(block.timestamp);
            priceData.volumes.push(amount0);
        }

        priceData.lastUpdate = block.timestamp;
    }

    /**
     * @notice Update path performance metrics
     * @param path Trading path
     * @param profit Generated profit
     * @param gasUsed Gas consumed
     */
    function _updatePathPerformance(
        address[] memory path,
        uint256 profit,
        uint256 gasUsed
    ) internal {
        bytes32 pathHash = keccak256(abi.encodePacked(path));
        PerformanceMetrics storage metrics = pathPerformance[pathHash];

        // Calculate profitability
        if (profit > 0) {
            metrics.profitability = _calculateNewRate(
                metrics.profitability,
                (profit * BASIS_POINTS) / gasUsed,
                totalExecutions
            );
        }

        // Calculate efficiency
        uint256 efficiency = _calculateGasEfficiency(gasUsed);
        metrics.efficiency = _calculateNewRate(
            metrics.efficiency,
            efficiency,
            totalExecutions
        );

        // Calculate reliability
        metrics.reliability = _calculateNewRate(
            metrics.reliability,
            profit > 0 ? BASIS_POINTS : 0,
            totalExecutions
        );

        metrics.lastCalculated = block.timestamp;
    }

    /**
     * @notice Calculate 24h volume for token
     * @param token Token address
     */
    function _calculate24hVolume(
        address token
    ) internal view returns (uint256) {
        AnalyticsData storage data = tokenAnalytics[token];
        if (block.timestamp < data.lastUpdate + 24 hours) {
            return data.volume24h;
        }
        return 0; // Reset if more than 24h passed
    }

    /**
     * @notice Calculate moving average for token
     * @param token Token address
     * @param period Period to average over
     */
    function _calculateMovingAverage(
        address token,
        uint256 period
    ) internal view returns (uint256) {
        bytes32 pairHash = _getPairHash(token, WPLS);
        PriceData storage priceData = pairPriceData[pairHash];
        
        uint256 sum = 0;
        uint256 count = 0;
        
        for (uint256 i = 0; i < priceData.prices.length; i++) {
            if (block.timestamp - priceData.timestamps[i] <= period) {
                sum += priceData.prices[i];
                count++;
            }
        }

        return count > 0 ? sum / count : 0;
    }

    /**
     * @notice Calculate gas efficiency score
     * @param gasUsed Gas consumed
     */
    function _calculateGasEfficiency(
        uint256 gasUsed
    ) internal pure returns (uint256) {
        uint256 baselineGas = 500000; // Baseline gas usage
        if (gasUsed <= baselineGas) {
            return BASIS_POINTS;
        }
        return (baselineGas * BASIS_POINTS) / gasUsed;
    }

    /**
     * @notice Calculate new rate with historical weighting
     * @param currentRate Current rate
     * @param newValue New value
     * @param count Total count
     */
    function _calculateNewRate(
        uint256 currentRate,
        uint256 newValue,
        uint256 count
    ) internal pure returns (uint256) {
        if (count == 0) return newValue;
        return ((currentRate * count) + newValue) / (count + 1);
    }

    /**
     * @notice Get hash for token pair
     * @param token0 First token
     * @param token1 Second token
     */
    function _getPairHash(
        address token0,
        address token1
    ) internal pure returns (bytes32) {
        return keccak256(abi.encodePacked(
            token0 < token1 ? token0 : token1,
            token0 < token1 ? token1 : token0
        ));
    }

    // Analytics events
    event AnalyticsUpdated(
        bytes32 indexed identifier,
        uint256 profit,
        uint256 gasUsed,
        uint256 timestamp
    );

    event MetricsCalculated(
        bytes32 indexed pathHash,
        uint256 profitability,
        uint256 efficiency,
        uint256 reliability,
        uint256 timestamp
    );

    // ============ Helper Functions ============

    /**
     * @notice Safe token approval with amount reset
     * @param token Token to approve
     * @param spender Address to approve
     * @param amount Amount to approve
     */
    function _safeApprove(
        address token,
        address spender,
        uint256 amount
    ) internal {
        IERC20(token).approve(spender, 0);
        IERC20(token).approve(spender, amount);
    }

    /**
     * @notice Swap token to WPLS
     * @param token Token to swap
     * @param amount Amount to swap
     * @return Amount of WPLS received
     */
    function _swapToWPLS(
        address token,
        uint256 amount
    ) internal returns (uint256) {
        if (token == WPLS || amount == 0) return 0;

        // Setup path
        address[] memory path = new address[](2);
        path[0] = token;
        path[1] = WPLS;

        // Approve router
        _safeApprove(token, PULSEX_ROUTER, amount);

        try IPulseXRouter(PULSEX_ROUTER).swapExactTokensForTokens(
            amount,
            0, // Accept any amount of WPLS
            path,
            address(this),
            block.timestamp + 1 // Short deadline
        ) returns (uint256[] memory amounts) {
            return amounts[amounts.length - 1];
        } catch {
            return 0;
        }
    }

    /**
     * @notice Get reserves for token pair
     * @param tokenA First token
     * @param tokenB Second token
     * @return reserve0 First token reserve
     * @return reserve1 Second token reserve
     */
    function _getPairReserves(
        address tokenA,
        address tokenB
    ) internal view returns (uint256 reserve0, uint256 reserve1) {
        address pair = IPulseXFactory(PULSEX_FACTORY).getPair(tokenA, tokenB);
        if (pair == address(0)) return (0, 0);

        (uint112 _reserve0, uint112 _reserve1,) = IPulseXPair(pair).getReserves();
        return (uint256(_reserve0), uint256(_reserve1));
    }

    /**
     * @notice Calculate square root for normalization
     * @param x Input value
     * @return y Square root result
     */
    function _sqrt(
        uint256 x
    ) internal pure returns (uint256 y) {
        if (x == 0) return 0;
        
        uint256 z = (x + 1) / 2;
        y = x;
        
        while (z < y) {
            y = z;
            z = (x / z + z) / 2;
        }
    }

    /**
     * @notice Convert wei value to PLS with 18 decimals
     * @param amount Wei amount
     * @return PLS amount
     */
    function _toPLS(
        uint256 amount
    ) internal pure returns (uint256) {
        return amount / 1e18;
    }

    /**
     * @notice Convert PLS to wei value
     * @param amount PLS amount
     * @return Wei amount
     */
    function _toWei(
        uint256 amount
    ) internal pure returns (uint256) {
        return amount * 1e18;
    }

    /**
     * @notice Calculate percentage of total
     * @param amount Amount to calculate
     * @param total Total amount
     * @return Percentage in basis points
     */
    function _calculatePercentage(
        uint256 amount,
        uint256 total
    ) internal pure returns (uint256) {
        if (total == 0) return 0;
        return (amount * BASIS_POINTS) / total;
    }

    /**
     * @notice Apply percentage to amount
     * @param amount Base amount
     * @param percentage Percentage in basis points
     * @return Result amount
     */
    function _applyPercentage(
        uint256 amount,
        uint256 percentage
    ) internal pure returns (uint256) {
        return (amount * percentage) / BASIS_POINTS;
    }

    /**
     * @notice Verify array length match
     * @param path Token path
     * @param amounts Amount array
     * @return Whether lengths match
     */
    function _verifyArrayLengths(
        address[] memory path,
        uint256[] memory amounts
    ) internal pure returns (bool) {
        return path.length >= 2 && path.length == amounts.length;
    }

    /**
     * @notice Get minimum output amount with slippage
     * @param amount Input amount
     * @param slippage Slippage in basis points
     * @return Minimum output amount
     */
    function _getMinimumOutput(
        uint256 amount,
        uint256 slippage
    ) internal pure returns (uint256) {
        return amount - ((amount * slippage) / BASIS_POINTS);
    }

    /**
     * @notice Split amount into parts
     * @param amount Total amount
     * @param parts Number of parts
     * @return amounts Array of split amounts
     */
    function _splitAmount(
        uint256 amount,
        uint256 parts
    ) internal pure returns (uint256[] memory amounts) {
        require(parts > 0, "Invalid parts");
        amounts = new uint256[](parts);
        uint256 baseAmount = amount / parts;
        uint256 remainder = amount % parts;

        for (uint256 i = 0; i < parts; i++) {
            amounts[i] = baseAmount;
            if (i < remainder) {
                amounts[i]++;
            }
        }
    }

    /**
     * @notice Validate deadline
     * @param deadline Transaction deadline
     * @return Whether deadline is valid
     */
    function _isValidDeadline(
        uint256 deadline
    ) internal view returns (bool) {
        return deadline >= block.timestamp;
    }

    /**
     * @notice Get gas price with buffer
     * @return Gas price with safety buffer
     */
    function _getSafeGasPrice() internal view returns (uint256) {
        return Math.min(
            block.basefee + GAS_RESERVE_BPS,
            MAX_GAS_PRICE
        );
    }

    /**
     * @notice Parse revert reason from response
     * @param response Error response
     * @return Parsed reason string
     */
    function _parseRevertReason(
        bytes memory response
    ) internal pure returns (string memory) {
        // Slice out revert string from response
        if (response.length < 68) return "Unknown error";
        bytes memory revertData = new bytes(response.length - 68);
        for (uint256 i = 0; i < revertData.length; i++) {
            revertData[i] = response[i + 68];
        }
        return string(revertData);
    }
