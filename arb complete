    // ============ Emergency Functions ============

    struct EmergencyState {
        bool emergencyMode;           // Emergency mode status
        uint256 lastEmergencyAction;  // Last emergency action timestamp
        string lastActionReason;      // Reason for last action
        address lastActionInitiator;  // Address that initiated last action
        uint256 recoveryDelay;        // Required delay before recovery
    }

    EmergencyState public emergencyState;
    uint256 private constant MIN_RECOVERY_DELAY = 1 hours;
    uint256 private constant MAX_RECOVERY_ATTEMPTS = 3;
    uint256 private recoveryAttempts;

    /**
     * @notice Activate emergency stop
     * @param reason Reason for emergency stop
     */
    function emergencyStop(
        string calldata reason
    ) external onlyRole(EMERGENCY_ADMIN_ROLE) whenNotPaused {
        require(!emergencyState.emergencyMode, "Already in emergency mode");
        
        // Activate emergency mode
        emergencyState.emergencyMode = true;
        emergencyState.lastEmergencyAction = block.timestamp;
        emergencyState.lastActionReason = reason;
        emergencyState.lastActionInitiator = msg.sender;
        emergencyState.recoveryDelay = MIN_RECOVERY_DELAY;

        // Pause contract
        _pause();

        // Cancel active operations
        _cancelActiveOperations();

        // Clear active flash loans
        _clearActiveFlashLoans();

        // Move funds to secure storage
        _secureEmergencyFunds();

        emit EmergencyActivated(
            reason,
            msg.sender,
            block.timestamp
        );
    }

    /**
     * @notice Clear active operations in emergency
     */
    function _cancelActiveOperations() internal {
        // Cancel active trades
        for (uint256 i = 0; i < activePaths.length; i++) {
            bytes32 pathHash = activePaths[i];
            if (activeFlashLoans[pathHash].isActive) {
                delete activeFlashLoans[pathHash];
            }
        }

        delete activePaths;

        emit ActiveOperationsCancelled(block.timestamp);
    }

    /**
     * @notice Clear active flash loans
     */
    function _clearActiveFlashLoans() internal {
        for (uint256 i = 0; i < activePaths.length; i++) {
            bytes32 pathHash = activePaths[i];
            FlashLoanData storage loan = activeFlashLoans[pathHash];
            if (loan.isActive) {
                emit FlashLoanFailed(
                    loan.identifier,
                    "Emergency stop",
                    "",
                    block.timestamp
                );
                delete activeFlashLoans[pathHash];
            }
        }
    }

    /**
     * @notice Secure funds during emergency
     */
    function _secureEmergencyFunds() internal {
        // Convert tokens to WPLS
        for (uint256 i = 0; i < tokenList.length; i++) {
            address token = tokenList[i];
            if (token != WPLS) {
                uint256 balance = IERC20(token).balanceOf(address(this));
                if (balance > 0) {
                    _swapToWPLS(token, balance);
                }
            }
        }

        // Update emergency fund
        emergencyFund = IERC20(WPLS).balanceOf(address(this));

        emit EmergencyFundsSecured(
            emergencyFund,
            block.timestamp
        );
    }

    /**
     * @notice Attempt recovery from emergency mode
     * @param reason Recovery attempt reason
     */
    function attemptRecovery(
        string calldata reason
    ) external onlyRole(EMERGENCY_ADMIN_ROLE) whenPaused {
        require(emergencyState.emergencyMode, "Not in emergency mode");
        require(
            block.timestamp >= emergencyState.lastEmergencyAction + emergencyState.recoveryDelay,
            "Recovery delay active"
        );
        require(recoveryAttempts < MAX_RECOVERY_ATTEMPTS, "Max attempts reached");

        // Increment attempt counter
        recoveryAttempts++;

        // Verify system safety
        require(_verifySafetyConditions(), "Safety check failed");
        require(_validateSystemHealth(), "System unhealthy");
        require(!_detectAnomalies(), "Anomalies detected");

        // Reset emergency state
        emergencyState.emergencyMode = false;
        emergencyState.lastEmergencyAction = block.timestamp;
        emergencyState.lastActionReason = reason;
        emergencyState.lastActionInitiator = msg.sender;

        // Unpause contract
        _unpause();

        // Reset recovery counter on success
        recoveryAttempts = 0;

        emit RecoveryCompleted(
            reason,
            msg.sender,
            block.timestamp
        );
    }

    /**
     * @notice Verify system safety conditions
     */
    function _verifySafetyConditions() internal view returns (bool) {
        // Verify contract integrity
        require(address(this).code.length > 0, "Contract not deployed");
        
        // Verify critical addresses
        require(
            protocolFeeCollector != address(0) &&
            devFeeCollector != address(0),
            "Invalid fee collectors"
        );

        // Verify token balances
        require(
            IERC20(WPLS).balanceOf(address(this)) >= emergencyFund,
            "Emergency fund depleted"
        );

        // Verify system state
        require(
            !circuitBreaker.isTriggered,
            "Circuit breaker active"
        );

        return true;
    }

    /**
     * @notice Emergency withdrawal of funds
     * @param tokens Array of token addresses
     */
    function emergencyWithdraw(
        address[] calldata tokens
    ) external onlyRole(EMERGENCY_ADMIN_ROLE) {
        require(emergencyState.emergencyMode, "Not in emergency mode");

        // Transfer native currency
        uint256 nativeBalance = address(this).balance;
        if (nativeBalance > 0) {
            (bool success,) = GENESIS_WALLET.call{value: nativeBalance}("");
            require(success, "Native transfer failed");
        }

        // Transfer tokens
        for (uint256 i = 0; i < tokens.length; i++) {
            IERC20 token = IERC20(tokens[i]);
            uint256 balance = token.balanceOf(address(this));
            if (balance > 0) {
                token.safeTransfer(GENESIS_WALLET, balance);
            }
        }

        emit EmergencyWithdrawal(
            tokens,
            msg.sender,
            block.timestamp
        );
    }

