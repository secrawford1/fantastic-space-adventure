    // ============ Trading & Path Execution Functions ============

    /**
     * @notice Find optimal router for token pair
     * @param tokenA First token
     * @param tokenB Second token
     * @param amount Trade amount
     */
    function _findOptimalRouter(
        address tokenA,
        address tokenB,
        uint256 amount
    ) internal view returns (address) {
        address bestRouter = PULSEX_ROUTER;
        uint256 bestScore = 0;

        for (uint256 i = 0; i < dexList.length; i++) {
            address router = dexList[i];
            if (!authorizedDEXs[router]) continue;

            uint256 score = _calculateRouterScore(
                router,
                tokenA,
                tokenB,
                amount
            );

            if (score > bestScore) {
                bestScore = score;
                bestRouter = router;
            }
        }

        return bestRouter;
    }

    /**
     * @notice Calculate router score based on performance metrics
     * @param router Router address
     * @param tokenA First token
     * @param tokenB Second token
     * @param amount Trade amount
     */
    function _calculateRouterScore(
        address router,
        address tokenA,
        address tokenB,
        uint256 amount
    ) internal view returns (uint256) {
        // Get reserves
        (uint256 reserveA, uint256 reserveB) = _getRouterReserves(
            router, 
            tokenA, 
            tokenB
        );

        if (reserveA == 0 || reserveB == 0) return 0;

        // Calculate base score from liquidity
        uint256 score = Math.sqrt(reserveA * reserveB);
        
        // Adjust for price impact
        uint256 impact = (amount * BASIS_POINTS) / Math.min(reserveA, reserveB);
        if (impact > MAX_SLIPPAGE) return 0;
        score = score * (BASIS_POINTS - impact) / BASIS_POINTS;

        // Adjust for historical performance
        uint256 pathHash = uint256(keccak256(abi.encodePacked(router, tokenA, tokenB)));
        score = score * (BASIS_POINTS + pathSuccessRate[bytes32(pathHash)]) / BASIS_POINTS;

        return score;
    }

    /**
     * @notice Get router reserves for token pair
     * @param router Router to check
     * @param tokenA First token
     * @param tokenB Second token
     */
    function _getRouterReserves(
        address router,
        address tokenA,
        address tokenB
    ) internal view returns (uint256 reserveA, uint256 reserveB) {
        address pair = IPulseXFactory(IPulseXRouter(router).factory())
            .getPair(tokenA, tokenB);
        
        if (pair == address(0)) return (0, 0);

        (uint112 reserve0, uint112 reserve1,) = IPulseXPair(pair).getReserves();
        
        return tokenA < tokenB ? 
            (uint256(reserve0), uint256(reserve1)) : 
            (uint256(reserve1), uint256(reserve0));
    }

    /**
     * @notice Validate and optimize trade path
     * @param path Token path
     * @param amounts Trade amounts
     */
    function _validateAndOptimizePath(
        address[] memory path,
        uint256[] memory amounts
    ) internal view returns (bool valid, uint256[] memory optimized) {
        optimized = new uint256[](amounts.length);
        optimized[0] = amounts[0];

        for (uint256 i = 0; i < path.length - 1; i++) {
            // Get optimal router and reserves
            address router = _findOptimalRouter(path[i], path[i+1], optimized[i]);
            (uint256 reserveIn, uint256 reserveOut) = _getRouterReserves(
                router,
                path[i],
                path[i+1]
            );

            // Validate liquidity
            if (reserveIn < MIN_LIQUIDITY || reserveOut < MIN_LIQUIDITY) {
                return (false, optimized);
            }

            // Calculate optimal output
            try IPulseXRouter(router).getAmountsOut(
                optimized[i],
                _getPathSegment(path[i], path[i+1])
            ) returns (uint256[] memory amountsOut) {
                optimized[i+1] = amountsOut[1];
            } catch {
                return (false, optimized);
            }
        }

        return (true, optimized);
    }

    /**
     * @notice Create path segment for router
     * @param tokenA First token
     * @param tokenB Second token
     */
    function _getPathSegment(
        address tokenA,
        address tokenB
    ) internal pure returns (address[] memory) {
        address[] memory segment = new address[](2);
        segment[0] = tokenA;
        segment[1] = tokenB;
        return segment;
    }

    /**
     * @notice Update path metrics after execution
     * @param path Token path
     * @param success Whether execution was successful
     * @param profit Amount of profit generated
     */
    function _updatePathMetrics(
        address[] memory path,
        bool success,
        uint256 profit
    ) internal {
        bytes32 pathHash = keccak256(abi.encodePacked(path));
        
        if (success) {
            // Update success rate
            uint256 failures = pathFailures[pathHash];
            if (failures > 0) pathFailures[pathHash]--;
            
            // Update success metrics
            pathSuccessRate[pathHash] = _calculateUpdatedSuccessRate(
                pathSuccessRate[pathHash],
                BASIS_POINTS,
                failures
            );
        } else {
            pathFailures[pathHash]++;
            
            // Trigger circuit breaker if too many failures
            if (pathFailures[pathHash] >= 3) {
                _triggerCircuitBreaker("Excessive path failures");
            }
        }

        emit PathMetricsUpdated(
            pathHash,
            success,
            profit,
            pathFailures[pathHash],
            block.timestamp
        );
    }

    /**
     * @notice Calculate updated success rate
     * @param currentRate Current success rate
     * @param newValue New value (BASIS_POINTS for success, 0 for failure)
     * @param failures Number of failures
     */
    function _calculateUpdatedSuccessRate(
        uint256 currentRate,
        uint256 newValue,
        uint256 failures
    ) internal pure returns (uint256) {
        if (failures == 0) return newValue;
        return (currentRate * failures + newValue) / (failures + 1);
    }

