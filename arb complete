    );

    // ============ Self-Funding Management ============

    /**
     * @notice Process and distribute arbitrage profit
     * @param profit Amount of profit to process
     * @return remainingProfit Profit after fees and distributions
     */
    function _processArbitrageProfit(uint256 profit) internal returns (uint256) {
        if (profit == 0) return 0;

        // Calculate fee allocations
        uint256 protocolFeeAmount = (profit * PROTOCOL_FEE) / BASIS_POINTS;
        uint256 devFeeAmount = (profit * DEV_FEE) / BASIS_POINTS;
        uint256 stakingReward = (profit * 2000) / BASIS_POINTS; // 20% to staking
        
        // Process protocol fee
        if (protocolFeeAmount > 0) {
            totalProtocolFees += protocolFeeAmount;
            require(
                IERC20(WPLS).transfer(protocolFeeCollector, protocolFeeAmount),
                "Protocol fee transfer failed"
            );
        }

        // Process dev fee
        if (devFeeAmount > 0) {
            totalDevFees += devFeeAmount;
            require(
                IERC20(WPLS).transfer(devFeeCollector, devFeeAmount),
                "Dev fee transfer failed"
            );
        }

        // Process staking rewards
        if (stakingReward > 0 && totalStaked > 0) {
            _distributeStakingRewards(stakingReward);
        }

        // Calculate remaining profit for self-funding
        uint256 remainingProfit = profit 
            - protocolFeeAmount 
            - devFeeAmount 
            - stakingReward;
            
        // Process self-funding allocations
        _processSelfFunding(remainingProfit);

        emit ProfitProcessed(
            profit,
            protocolFeeAmount,
            devFeeAmount,
            stakingReward,
            remainingProfit,
            block.timestamp
        );

        return remainingProfit;
    }

    /**
     * @notice Process self-funding allocations
     * @param profit Amount to allocate
     */
    function _processSelfFunding(uint256 profit) internal {
        if (profit == 0) return;

        // Calculate optimal allocations
        (uint256 flashLoanAllocation, uint256 liquidityAllocation) = 
            _calculateOptimalAllocations(profit);

        // Process flash loan pool allocation
        if (flashLoanAllocation > 0) {
            _addToFlashLoanPool(flashLoanAllocation);
        }

        // Process liquidity pool allocation
        if (liquidityAllocation > 0) {
            _addToLiquidityPool(liquidityAllocation);
        }

        // Update emergency fund if needed
        if (emergencyFund < selfFundingConfig.emergencyThreshold) {
            uint256 emergencyAllocation = (profit * 1000) / BASIS_POINTS; // 10%
            emergencyFund += emergencyAllocation;
            emit EmergencyFundUpdated(emergencyFund, emergencyAllocation, block.timestamp);
        }

        emit SelfFundingProcessed(
            profit,
            flashLoanAllocation,
            liquidityAllocation,
            block.timestamp
        );
    }

    /**
     * @notice Calculate optimal profit allocations
     * @param profit Total profit to allocate
     * @return flashLoanAllocation Amount for flash loan pool
     * @return liquidityAllocation Amount for liquidity pool
     */
    function _calculateOptimalAllocations(uint256 profit) 
        internal 
        view 
        returns (uint256 flashLoanAllocation, uint256 liquidityAllocation) 
    {
        uint256 currentLiquidity = _calculateTotalLiquidity();
        uint256 baseReinvestRate = selfFundingConfig.reinvestmentRate;

        // Adjust reinvestment rate based on current liquidity
        if (currentLiquidity < selfFundingConfig.targetLiquidity) {
            // Increase reinvestment when below target
            uint256 deficit = selfFundingConfig.targetLiquidity - currentLiquidity;
            baseReinvestRate += (deficit * 1000) / selfFundingConfig.targetLiquidity;
        } else if (currentLiquidity > selfFundingConfig.maxLiquidity) {
            // Decrease reinvestment when above max
            baseReinvestRate = (baseReinvestRate * 8000) / BASIS_POINTS; // 20% reduction
        }

        uint256 totalReinvestment = (profit * baseReinvestRate) / BASIS_POINTS;
        
        // Split between flash loan pool and liquidity
        flashLoanAllocation = (totalReinvestment * 6000) / BASIS_POINTS; // 60%
        liquidityAllocation = totalReinvestment - flashLoanAllocation;

        return (flashLoanAllocation, liquidityAllocation);
    }

    /**
     * @notice Add funds to flash loan pool
     * @param amount Amount to add
     */
    function _addToFlashLoanPool(uint256 amount) internal {
        if (amount == 0) return;

        // Convert to WPLS if needed
        if (address(this).balance >= amount) {
            IWPLS(WPLS).deposit{value: amount}();
        }

        // Update flash loan capacity
        flastLoanCapacity += amount;

        emit FlashLoanPoolUpdated(
            flastLoanCapacity,
            amount,
            block.timestamp
        );
    }

    /**
     * @notice Add funds to liquidity pool
     * @param amount Amount to add
     */
    function _addToLiquidityPool(uint256 amount) internal {
        if (amount == 0) return;

        // Convert to WPLS if needed
        if (address(this).balance >= amount) {
            IWPLS(WPLS).deposit{value: amount}();
        }

        // Find optimal pools for liquidity
        address[] memory optimalPools = _findOptimalLiquidityPools();
        uint256 amountPerPool = amount / optimalPools.length;

        for (uint256 i = 0; i < optimalPools.length; i++) {
            _addLiquidityToPool(optimalPools[i], amountPerPool);
        }
    }

    /**
     * @notice Find optimal pools for liquidity
     */
    function _findOptimalLiquidityPools() internal view returns (address[] memory) {
        uint256 poolCount = 0;
        address[] memory pools = new address[](dexList.length);

        // Find pools meeting criteria
        for (uint256 i = 0; i < dexList.length; i++) {
            address router = dexList[i];
            if (_validatePoolQuality(router)) {
                pools[poolCount] = router;
                poolCount++;
            }
        }

        // Create right-sized array
        address[] memory optimalPools = new address[](poolCount);
        for (uint256 i = 0; i < poolCount; i++) {
            optimalPools[i] = pools[i];
        }

        return optimalPools;
    }

    /**
     * @notice Calculate total protocol liquidity
     */
    function _calculateTotalLiquidity() internal view returns (uint256) {
        uint256 total = flastLoanCapacity;  // Flash loan pool

        // Add liquidity positions
        for (uint256 i = 0; i < liquidityPositions.length; i++) {
            total += _getLiquidityPositionValue(liquidityPositions[i]);
        }

        // Add available balance
        total += IERC20(WPLS).balanceOf(address(this));
        total += address(this).balance;

        return total;
    }

    /**
     * @notice Get liquidity position value
     * @param lpToken LP token address
     */
    function _getLiquidityPositionValue(address lpToken) internal view returns (uint256) {
        uint256 balance = IERC20(lpToken).balanceOf(address(this));
        if (balance == 0) return 0;

        // Get underlying tokens
        address token0 = IPulseXPair(lpToken).token0();
        address token1 = IPulseXPair(lpToken).token1();

        // Get reserves
        (uint112 reserve0, uint112 reserve1,) = IPulseXPair(lpToken).getReserves();
        uint256 totalSupply = IERC20(lpToken).totalSupply();

        // Calculate share of reserves
        uint256 share0 = (balance * uint256(reserve0)) / totalSupply;
        uint256 share1 = (balance * uint256(reserve1)) / totalSupply;

        // Convert to common denominator (WPLS)
        return share0 + share1;
    }

