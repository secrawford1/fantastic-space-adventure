    // ============ Core Arbitrage Functions ============
    
    struct ArbitrageParameters {
        address[] path;
        uint256[] amounts;
        uint256 expectedProfit;
        uint256 minAmountOut;
        uint256 deadline;
        bool useFlashLoan;
        bytes32 identifier;
    }

    /**
     * @notice Execute arbitrage opportunity
     * @param params Arbitrage parameters
     * @return profit Amount of profit generated
     */
    function executeArbitrage(
        ArbitrageParameters calldata params
    ) 
        external 
        onlyOperator 
        nonReentrant 
        whenNotPaused 
        validatePath(params.path)
        returns (uint256 profit) 
    {
        require(tx.gasprice <= MAX_GAS_PRICE, "Gas price too high");
        require(params.path.length >= 2 && params.path.length == params.amounts.length, "Invalid parameters");
        require(block.timestamp <= params.deadline, "Deadline expired");
        
        // Verify system state
        require(_validateSystemHealth(), "System unhealthy");
        require(!circuitBreaker.isTriggered, "Circuit breaker active");

        // Record initial state
        uint256 startGas = gasleft();
        bytes32 startState = _calculateMarketState(params.path);

        // Execute based on strategy
        if (params.useFlashLoan) {
            profit = _executeWithFlashLoan(params);
        } else {
            profit = _executeStandardArbitrage(params);
        }

        // Process profit if successful
        if (profit > 0) {
            // Update metrics
            totalExecutions++;
            successfulExecutions++;
            totalGasSpent += startGas - gasleft();
            
            // Process fees and profits
            profit = _processArbitrageProfit(profit);

            emit ArbitrageExecuted(
                params.identifier,
                params.path,
                params.amounts[0],
                profit,
                startGas - gasleft(),
                params.useFlashLoan,
                block.timestamp
            );
        }

        // Verify final state
        bytes32 endState = _calculateMarketState(params.path);
        emit MarketStateChanged(
            params.identifier,
            startState,
            endState,
            block.timestamp
        );

        return profit;
    }

    /**
     * @notice Execute standard arbitrage without flash loan
     * @param params Arbitrage parameters
     * @return profit Amount of profit generated
     */
    function _executeStandardArbitrage(
        ArbitrageParameters memory params
    ) internal returns (uint256) {
        uint256 initialBalance = IERC20(params.path[0]).balanceOf(address(this));
        require(initialBalance >= params.amounts[0], "Insufficient balance");

        // Execute trades
        bool success = _executeArbitragePath(
            params.path,
            params.amounts[0],
            params.minAmountOut
        );

        require(success, "Trade execution failed");

        // Calculate profit
        uint256 finalBalance = IERC20(params.path[0]).balanceOf(address(this));
        require(finalBalance > initialBalance, "No profit generated");

        return finalBalance - initialBalance;
    }

    /**
     * @notice Execute arbitrage path
     * @param path Token path
     * @param initialAmount Initial amount
     * @param minAmountOut Minimum output amount
     * @return Whether execution was successful
     */
    function _executeArbitragePath(
        address[] memory path,
        uint256 initialAmount,
        uint256 minAmountOut
    ) internal returns (bool) {
        uint256 currentAmount = initialAmount;

        // Execute trades through the path
        for (uint256 i = 0; i < path.length - 1; i++) {
            // Find optimal router for the pair
            address router = _findOptimalRouter(
                path[i],
                path[i + 1],
                currentAmount
            );

            // Apply MEV protection
            require(
                !_detectMEVAttack(path, currentAmount),
                "MEV attack detected"
            );

            // Execute swap
            currentAmount = _executeSwap(
                router,
                path[i],
                path[i + 1],
                currentAmount,
                0 // Use minimal output to pass through path
            );

            if (currentAmount == 0) {
                return false;
            }
        }

        // Verify final output meets minimum
        return currentAmount >= minAmountOut;
    }

    /**
     * @notice Execute single swap
     * @param router Router to use
     * @param tokenIn Input token
     * @param tokenOut Output token
     * @param amountIn Input amount
     * @param minAmountOut Minimum output amount
     * @return Amount received from swap
     */
    function _executeSwap(
        address router,
        address tokenIn,
        address tokenOut,
        uint256 amountIn,
        uint256 minAmountOut
    ) internal returns (uint256) {
        // Record initial balance
        uint256 balanceBefore = IERC20(tokenOut).balanceOf(address(this));

        // Setup path
        address[] memory path = new address[](2);
        path[0] = tokenIn;
        path[1] = tokenOut;

        // Execute swap
        try IPulseXRouter(router).swapExactTokensForTokensSupportingFeeOnTransferTokens(
            amountIn,
            minAmountOut,
            path,
            address(this),
            block.timestamp + 2 // 2 blocks deadline
        ) {
            uint256 balanceAfter = IERC20(tokenOut).balanceOf(address(this));
            uint256 outputAmount = balanceAfter - balanceBefore;

            require(outputAmount >= minAmountOut, "Insufficient output");

            return outputAmount;
        } catch {
            return 0;
        }
    }

    /**
     * @notice Calculate market state
     * @param path Token path
     * @return State hash
     */
    function _calculateMarketState(
        address[] memory path
    ) internal view returns (bytes32) {
        bytes memory stateData;

        // Collect reserves for each pair
        for (uint256 i = 0; i < path.length - 1; i++) {
            (uint112 reserve0, uint112 reserve1,) = IPulseXPair(
                IPulseXFactory(PULSEX_FACTORY).getPair(path[i], path[i + 1])
            ).getReserves();

            stateData = abi.encodePacked(
                stateData,
                reserve0,
                reserve1
            );
        }

        return keccak256(stateData);
    }

