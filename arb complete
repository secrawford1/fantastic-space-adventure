    // ============ Fee Management ============

    struct FeeConfig {
        uint256 protocolFeeBps;      // Protocol fee in basis points
        uint256 devFeeBps;           // Dev fee in basis points
        uint256 stakingFeeBps;       // Staking rewards fee in basis points
        uint256 liquidityFeeBps;     // Liquidity provision fee in basis points
        uint256 lastUpdate;          // Last fee update timestamp
    }

    struct FeeCollector {
        address collector;           // Fee collector address
        uint256 pendingFees;        // Pending fees for collection
        uint256 totalCollected;     // Total fees collected
        uint256 lastCollection;     // Last collection timestamp
    }

    FeeConfig public feeConfig;
    mapping(bytes32 => FeeCollector) public feeCollectors;
    
    /**
     * @notice Initialize fee configuration
     */
    function _initializeFeeConfig() internal {
        feeConfig = FeeConfig({
            protocolFeeBps: PROTOCOL_FEE,    // 0.3%
            devFeeBps: DEV_FEE,              // 0.1%
            stakingFeeBps: 2000,             // 20%
            liquidityFeeBps: 1000,           // 10%
            lastUpdate: block.timestamp
        });

        // Setup fee collectors
        _setFeeCollector("PROTOCOL", protocolFeeCollector);
        _setFeeCollector("DEV", devFeeCollector);
    }

    /**
     * @notice Set fee collector address
     * @param collectorType Type of collector
     * @param collector Address of collector
     */
    function _setFeeCollector(
        string memory collectorType,
        address collector
    ) internal {
        require(collector != address(0), "Invalid collector");
        bytes32 collectorHash = keccak256(abi.encodePacked(collectorType));
        
        feeCollectors[collectorHash] = FeeCollector({
            collector: collector,
            pendingFees: 0,
            totalCollected: 0,
            lastCollection: block.timestamp
        });
    }

    /**
     * @notice Process and distribute fees
     * @param amount Amount to process fees from
     * @return remainingAmount Amount after fees
     */
    function _processFees(
        uint256 amount
    ) internal returns (uint256) {
        if (amount == 0) return 0;

        // Calculate fee amounts
        uint256 protocolFee = (amount * feeConfig.protocolFeeBps) / BASIS_POINTS;
        uint256 devFee = (amount * feeConfig.devFeeBps) / BASIS_POINTS;
        uint256 stakingFee = (amount * feeConfig.stakingFeeBps) / BASIS_POINTS;
        uint256 liquidityFee = (amount * feeConfig.liquidityFeeBps) / BASIS_POINTS;

        // Process protocol fee
        _processFeeAmount("PROTOCOL", protocolFee);

        // Process dev fee
        _processFeeAmount("DEV", devFee);

        // Process staking rewards
        if (stakingFee > 0 && totalStaked > 0) {
            _distributeStakingRewards(stakingFee);
        }

        // Process liquidity fee
        if (liquidityFee > 0) {
            _addToLiquidityPool(liquidityFee);
        }

        // Calculate remaining amount
        uint256 remainingAmount = amount - protocolFee - devFee - stakingFee - liquidityFee;

        emit FeesProcessed(
            amount,
            protocolFee,
            devFee,
            stakingFee,
            liquidityFee,
            block.timestamp
        );

        return remainingAmount;
    }

    /**
     * @notice Process individual fee amount
     * @param collectorType Type of fee collector
     * @param amount Fee amount to process
     */
    function _processFeeAmount(
        string memory collectorType,
        uint256 amount
    ) internal {
        if (amount == 0) return;

        bytes32 collectorHash = keccak256(abi.encodePacked(collectorType));
        FeeCollector storage collector = feeCollectors[collectorHash];

        // Transfer fee if threshold reached
        if (amount + collector.pendingFees >= MIN_FEE_COLLECTION) {
            uint256 totalFees = amount + collector.pendingFees;
            require(
                IERC20(WPLS).transfer(collector.collector, totalFees),
                "Fee transfer failed"
            );

            collector.totalCollected += totalFees;
            collector.lastCollection = block.timestamp;
            collector.pendingFees = 0;

            emit FeesCollected(
                collectorType,
                collector.collector,
                totalFees,
                block.timestamp
            );
        } else {
            // Accumulate pending fees
            collector.pendingFees += amount;
        }
    }

    /**
     * @notice Update fee configuration
     * @param newConfig New fee configuration
     */
    function updateFeeConfig(
        FeeConfig calldata newConfig
    ) external onlyRole(TIMELOCK_ADMIN_ROLE) {
        // Validate total fees don't exceed maximum
        require(
            newConfig.protocolFeeBps +
            newConfig.devFeeBps +
            newConfig.stakingFeeBps +
            newConfig.liquidityFeeBps <= MAX_FEE,
            "Total fees too high"
        );

        emit FeeConfigUpdated(
            newConfig.protocolFeeBps,
            newConfig.devFeeBps,
            newConfig.stakingFeeBps,
            newConfig.liquidityFeeBps,
            block.timestamp
        );

        feeConfig = newConfig;
    }

    /**
     * @notice Update fee collector
     * @param collectorType Type of collector to update
     * @param newCollector New collector address
     */
    function updateFeeCollector(
        string calldata collectorType,
        address newCollector
    ) external onlyRole(TREASURY_ROLE) {
        bytes32 collectorHash = keccak256(abi.encodePacked(collectorType));
        FeeCollector storage collector = feeCollectors[collectorHash];
        
        // Process any pending fees before update
        if (collector.pendingFees > 0) {
            _processFeeAmount(collectorType, 0);
        }

        address oldCollector = collector.collector;
        _setFeeCollector(collectorType, newCollector);

        emit FeeCollectorUpdated(
            collectorType,
            oldCollector,
            newCollector,
            block.timestamp
        );
    }

