    // ============ MEV Protection ============

    struct MEVProtectionConfig {
        uint256 backrunThreshold;     // Threshold for backrun detection
        uint256 frontrunThreshold;    // Threshold for frontrun detection
        uint256 sandwichThreshold;    // Threshold for sandwich attack detection
        uint256 blockWindow;          // Block window for pattern detection
        bool active;                  // Whether protection is active
    }

    struct MEVProtectionMetrics {
        uint256[] backrunHistory;     // Historical backrun patterns
        uint256[] frontrunHistory;    // Historical frontrun patterns
        uint256 sandwichCount;        // Detected sandwich attacks
        uint256 lastBlockAnalyzed;    // Last block analyzed
        mapping(bytes32 => uint256) patternTimestamps;  // Pattern detection timestamps
    }

    MEVProtectionConfig public mevConfig;
    MEVProtectionMetrics private mevMetrics;

    /**
     * @notice Initialize MEV protection
     */
    function _initializeMEVProtection() internal {
        mevConfig = MEVProtectionConfig({
            backrunThreshold: 500,     // 5% threshold
            frontrunThreshold: 700,    // 7% threshold
            sandwichThreshold: 300,    // 3% threshold
            blockWindow: 10,           // 10 block window
            active: true
        });

        mevMetrics.lastBlockAnalyzed = block.number;
    }

    /**
     * @notice Detect MEV attacks in transaction
     * @param path Trading path
     * @param amount Trade amount
     */
    function _detectMEVAttack(
        address[] memory path,
        uint256 amount
    ) internal returns (bool) {
        if (!mevConfig.active) return false;

        // Calculate risk scores
        uint256 backrunRisk = _calculateBackrunRisk(path, amount);
        uint256 frontrunRisk = _calculateFrontrunRisk(path);
        uint256 sandwichRisk = _calculateSandwichRisk(path, amount);

        // Record metrics
        _recordMEVMetrics(backrunRisk, frontrunRisk, sandwichRisk);

        // Check if any risk exceeds thresholds
        if (backrunRisk >= mevConfig.backrunThreshold ||
            frontrunRisk >= mevConfig.frontrunThreshold ||
            sandwichRisk >= mevConfig.sandwichThreshold) {
                
            emit MEVAttackDetected(
                keccak256(abi.encodePacked(path, amount, block.number)),
                path,
                amount,
                backrunRisk + frontrunRisk + sandwichRisk,
                block.timestamp
            );
            return true;
        }

        return false;
    }

    /**
     * @notice Calculate backrun risk score
     * @param path Trading path
     * @param amount Trade amount
     */
    function _calculateBackrunRisk(
        address[] memory path,
        uint256 amount
    ) internal view returns (uint256) {
        uint256 riskScore = 0;

        for (uint256 i = 0; i < path.length - 1; i++) {
            // Calculate liquidity impact
            (uint256 reserve0, uint256 reserve1) = _getRouterReserves(
                PULSEX_ROUTER,
                path[i],
                path[i + 1]
            );

            // Higher risk for larger price impact
            uint256 impact = (amount * BASIS_POINTS) / Math.min(reserve0, reserve1);
            riskScore = Math.max(riskScore, impact);

            // Check for recent similar transactions
            bytes32 pairHash = keccak256(abi.encodePacked(path[i], path[i + 1]));
            uint256 recentPatterns = _countRecentPatterns(pairHash);
            riskScore += recentPatterns * 100; // Add 1% per recent pattern
        }

        return Math.min(riskScore, BASIS_POINTS); // Cap at 100%
    }

    /**
     * @notice Calculate frontrun risk score
     * @param path Trading path
     */
    function _calculateFrontrunRisk(
        address[] memory path
    ) internal view returns (uint256) {
        uint256 riskScore = 0;

        for (uint256 i = 0; i < path.length - 1; i++) {
            // Check historical frontrunning patterns
            bytes32 pairHash = keccak256(abi.encodePacked(path[i], path[i + 1]));
            
            // Higher risk for historically frontrun pairs
            for (uint256 j = 0; j < mevMetrics.frontrunHistory.length; j++) {
                if (mevMetrics.frontrunHistory[j] == uint256(pairHash)) {
                    riskScore += 200; // Add 2% per historical occurrence
                }
            }
        }

        return Math.min(riskScore, BASIS_POINTS);
    }

    /**
     * @notice Calculate sandwich attack risk score
     * @param path Trading path
     * @param amount Trade amount
     */
    function _calculateSandwichRisk(
        address[] memory path,
        uint256 amount
    ) internal view returns (uint256) {
        uint256 riskScore = 0;

        // Check recent block patterns
        for (uint256 i = 0; i < path.length - 1; i++) {
            bytes32 pairHash = keccak256(abi.encodePacked(path[i], path[i + 1]));
            
            // Analyze recent blocks
            for (uint256 j = 1; j <= mevConfig.blockWindow; j++) {
                bytes32 blockPattern = keccak256(abi.encodePacked(
                    blockhash(block.number - j),
                    pairHash
                ));
                
                if (mevMetrics.patternTimestamps[blockPattern] > 0) {
                    riskScore += 150; // Add 1.5% per detected pattern
                }
            }
        }

        return Math.min(riskScore, BASIS_POINTS);
    }

    /**
     * @notice Count recent MEV patterns
     * @param pairHash Hash of token pair
     */
    function _countRecentPatterns(bytes32 pairHash) internal view returns (uint256) {
        uint256 count = 0;
        uint256 startBlock = Math.max(block.number - mevConfig.blockWindow, mevMetrics.lastBlockAnalyzed);

        for (uint256 i = startBlock; i < block.number; i++) {
            bytes32 blockPattern = keccak256(abi.encodePacked(blockhash(i), pairHash));
            if (mevMetrics.patternTimestamps[blockPattern] > 0) {
                count++;
            }
        }

        return count;
    }

    /**
     * @notice Record MEV metrics for analysis
     * @param backrunRisk Backrun risk score
     * @param frontrunRisk Frontrun risk score
     * @param sandwichRisk Sandwich attack risk score 
     */
    function _recordMEVMetrics(
        uint256 backrunRisk,
        uint256 frontrunRisk,
        uint256 sandwichRisk
    ) internal {
        // Record pattern if high risk detected
        if (backrunRisk + frontrunRisk + sandwichRisk >= 1000) { // 10% combined risk
            bytes32 pattern = keccak256(abi.encodePacked(
                block.number,
                backrunRisk,
                frontrunRisk,
                sandwichRisk
            ));
            
            mevMetrics.patternTimestamps[pattern] = block.timestamp;
            
            if (sandwichRisk >= mevConfig.sandwichThreshold) {
                mevMetrics.sandwichCount++;
            }
        }

        emit MEVMetricsUpdated(
            backrunRisk,
            frontrunRisk,
            sandwichRisk,
            mevMetrics.sandwichCount,
            block.timestamp
        );
    }

    /**
     * @notice Update MEV protection configuration
     * @param newConfig New configuration settings
     */
    function updateMEVConfig(
        MEVProtectionConfig calldata newConfig
    ) external onlyRole(OPERATOR_ROLE) {
        require(newConfig.blockWindow > 0, "Invalid block window");
        require(newConfig.backrunThreshold <= BASIS_POINTS, "Invalid backrun threshold");
        require(newConfig.frontrunThreshold <= BASIS_POINTS, "Invalid frontrun threshold");
        require(newConfig.sandwichThreshold <= BASIS_POINTS, "Invalid sandwich threshold");

        mevConfig = newConfig;

        emit MEVConfigUpdated(
            newConfig.backrunThreshold,
            newConfig.frontrunThreshold,
            newConfig.sandwichThreshold,
            block.timestamp
        );
    }

