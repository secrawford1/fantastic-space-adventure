     */
    struct RiskThresholds {
        uint256 maxPositionSize;      // Maximum size per position
        uint256 maxExposurePerToken;  // Maximum exposure per token
        uint256 minProfitRatio;       // Minimum profit vs gas cost ratio
        uint256 maxSlippageImpact;    // Maximum allowed slippage
        uint256 minLiquidityRatio;    // Minimum liquidity vs position size
    }

    RiskThresholds public riskThresholds;

    /**
     * @notice Validate system health
     * @return Whether system is healthy
     */
    function _validateSystemHealth() internal view returns (bool) {
        // Check core balance requirements
        require(
            address(this).balance >= emergencyFund,
            "Emergency fund depleted"
        );
        require(
            currentGasReserve >= _calculateMinimumGasReserve(),
            "Insufficient gas reserve"
        );

        // Validate execution metrics
        require(
            successfulExecutions <= totalExecutions,
            "Invalid execution metrics"
        );
        require(
            dailyTrades <= MAX_DAILY_TRADES,
            "Daily trade limit exceeded"
        );

        // Check active flash loans
        for (uint256 i = 0; i < activePaths.length; i++) {
            bytes32 pathHash = activePaths[i];
            FlashLoanData storage loan = activeFlashLoans[pathHash];
            if (loan.isActive) {
                require(
                    loan.deadline > block.timestamp,
                    "Active loan expired"
                );
                require(
                    loan.borrowAmount <= flastLoanCapacity,
                    "Loan exceeds capacity"
                );
            }
        }

        return true;
    }

    /**
     * @notice Validate risk parameters for trade
     * @param path Token path
     * @param amount Trade amount
     * @param expectedProfit Expected profit
     */
    function _validateRiskParameters(
        address[] memory path,
        uint256 amount,
        uint256 expectedProfit
    ) internal view returns (bool) {
        // Check position size
        require(
            amount <= _calculateMaxPosition(path[0]),
            "Position size too large"
        );

        // Check token exposure
        require(
            _calculateTotalExposure(path[0]) + amount <= riskThresholds.maxExposurePerToken,
            "Token exposure too high"
        );

        // Check profit ratio vs gas cost
        uint256 estimatedGas = 500000; // Base gas estimate
        uint256 gasCost = estimatedGas * tx.gasprice;
        require(
            expectedProfit >= gasCost * riskThresholds.minProfitRatio / BASIS_POINTS,
            "Insufficient profit ratio"
        );

        return true;
    }

    /**
     * @notice Calculate maximum position size for token
     * @param token Token address
     */
    function _calculateMaxPosition(address token) internal view returns (uint256) {
        uint256 poolSize = _getPoolSize(token);
        return (poolSize * riskThresholds.maxPositionSize) / BASIS_POINTS;
    }

    /**
     * @notice Calculate total token exposure
     * @param token Token address
     */
    function _calculateTotalExposure(address token) internal view returns (uint256) {
        uint256 totalExposure = 0;

        // Sum active flash loans
        for (uint256 i = 0; i < activePaths.length; i++) {
            bytes32 pathHash = activePaths[i];
            FlashLoanData storage loan = activeFlashLoans[pathHash];
            if (loan.isActive && loan.path[0] == token) {
                totalExposure += loan.borrowAmount;
            }
        }

        // Add liquidity positions
        for (uint256 i = 0; i < liquidityPositions.length; i++) {
            address lpToken = liquidityPositions[i];
            if (IPulseXPair(lpToken).token0() == token || 
                IPulseXPair(lpToken).token1() == token) {
                totalExposure += _getLiquidityPositionValue(lpToken) / 2;
            }
        }

        return totalExposure;
    }

    /**
     * @notice Calculate minimum gas reserve
     */
    function _calculateMinimumGasReserve() internal view returns (uint256) {
        return (address(this).balance * GAS_RESERVE_BPS) / BASIS_POINTS;
    }

    /**
     * @notice Get pool size for token
     * @param token Token address
     */
    function _getPoolSize(address token) internal view returns (uint256) {
        address pair = IPulseXFactory(PULSEX_FACTORY).getPair(token, WPLS);
        if (pair == address(0)) return 0;

        (uint112 reserve0, uint112 reserve1,) = IPulseXPair(pair).getReserves();
        return token < WPLS ? uint256(reserve0) : uint256(reserve1);
    }

    /**
     * @notice Update risk thresholds
     * @param newThresholds New risk thresholds
     */
    function updateRiskThresholds(
        RiskThresholds calldata newThresholds
    ) external onlyRole(TIMELOCK_ADMIN_ROLE) {
        require(
            newThresholds.maxPositionSize <= BASIS_POINTS,
            "Invalid position size limit"
        );
        require(
            newThresholds.minProfitRatio >= 110,  // 110% minimum profit ratio
            "Invalid profit ratio"
        );
        require(
            newThresholds.maxSlippageImpact <= 1000, // Max 10% slippage
            "Invalid slippage limit"
        );

        emit RiskThresholdsUpdated(
            riskThresholds.maxPositionSize,
            newThresholds.maxPositionSize,
            block.timestamp
        );

        riskThresholds = newThresholds;
    }

    /**
     * @notice Validate pool quality
     * @param router Router to validate
     */
    function _validatePoolQuality(address router) internal view returns (bool) {
        // Check router authorization
        if (!authorizedDEXs[router]) return false;

        // Calculate success rate
        uint256 successRate = successfulExecutions * BASIS_POINTS / 
            (totalExecutions > 0 ? totalExecutions : 1);
            
        if (successRate < 8000) return false; // Require 80% success

        // Check minimum liquidity
        if (_calculateTotalLiquidity() < MIN_LIQUIDITY) return false;

        return true;
    }

