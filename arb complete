    // ============ Constructor & Initialization ============
    constructor(address _admin, address _operator) 
        Ownable(msg.sender) 
    {
        require(_admin != address(0), "Invalid admin address");
        require(_operator != address(0), "Invalid operator address");

        // Setup core interfaces
        pulseXRouter = IPulseXRouter(PULSEX_ROUTER);
        pulseXFactory = IPulseXFactory(PULSEX_FACTORY);
        wrapPLS = IWPLS(WPLS);
        lendingPool = ILendingPool(PULSEX_ROUTER);

        // Setup fee collectors
        protocolFeeCollector = GENESIS_WALLET;
        devFeeCollector = GENESIS_WALLET;

        // Initialize core components
        _initializeBaseComponents();
        
        // Initialize advanced systems
        _initializeAdvancedSystems();
        
        // Initialize self funding
        _initializeSelfFunding();
        
        // Setup initial roles
        _setupInitialRoles(_admin, _operator);
        
        // Initialize security
        _initializeSecurity();
    }

    function _initializeBaseComponents() internal {
        _emergencyLock = false;
        _maintenanceMode = false;
        _stakeReentryGuard = false;

        // Initialize performance tracking
        totalExecutions = 0;
        successfulExecutions = 0;
        totalProfit = 0;

        // Set initial gas reserve
        currentGasReserve = 5 ether;
        emergencyFund = 0;

        // Initialize state
        lastUpdateBlock = block.number;
        currentVersion = 1;

        // Approve routers for WPLS
        IERC20(WPLS).approve(PULSEX_ROUTER, type(uint256).max);
    }

    function _initializeAdvancedSystems() internal {
        // Initialize circuit breaker
        circuitBreaker = CircuitBreaker({
            priceDeviationLimit: 300, // 3%
            volumeAnomalyThreshold: 5000, // 50%
            profitabilityThreshold: 1e15, // 0.001 PLS
            gasSpikeTolerance: 200,
            lastResetTime: block.timestamp,
            isTriggered: false,
            lastTriggerReason: ""
        });
    }

    function _initializeSelfFunding() internal {
        selfFundingConfig = SelfFundingConfig({
            targetLiquidity: 100 ether,
            minLiquidity: 10 ether,
            maxLiquidity: 1000 ether,
            reinvestmentRate: 7000,    // 70% reinvestment
            emergencyThreshold: 20 ether,
            lastRebalance: block.timestamp,
            autoCompound: true
        });

        flastLoanCapacity = 0;
    }

    function _setupInitialRoles(address _admin, address _operator) internal {
        _grantRole(DEFAULT_ADMIN_ROLE, _admin);
        _grantRole(TIMELOCK_ADMIN_ROLE, _admin);
        _grantRole(UPGRADE_ROLE, _admin);
        _grantRole(OPERATOR_ROLE, _operator);
        _grantRole(EMERGENCY_ADMIN_ROLE, _admin);
        _grantRole(TREASURY_ROLE, _admin);
    }

    function _initializeSecurity() internal {
        // Initialize core tokens
        _initializeToken(WPLS, false, 0, 0, 0);
        _initializeToken(PLSX, false, 0, 0, 0);
        _initializeToken(INC, true, 0, 0, 0);
        _initializeToken(HEX, false, 0, 0, 0);

        // Authorize core DEX
        authorizedDEXs[PULSEX_ROUTER] = true;
        dexList.push(PULSEX_ROUTER);
    }

