        uint256 buyTax,
        uint256 sellTax,
        uint256 transferTax
    ) internal {
        require(token != address(0), "Invalid token address");
        require(!authorizedTokens[token], "Token already initialized");
        
        authorizedTokens[token] = true;
        tokenList.push(token);

        // Approve router
        IERC20(token).approve(PULSEX_ROUTER, type(uint256).max);
        
        emit TokenInitialized(
            token, 
            isTaxed, 
            buyTax,
            sellTax,
            transferTax,
            block.timestamp
        );
    }

